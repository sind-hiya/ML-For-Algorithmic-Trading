class MLLongShort(QCAlgorithm):

    def initialize(self):
        self.set_start_date(2015, 1, 1)
        self.set_end_date(2019, 12, 31)
        self.set_cash(100000)
        tickers = ["AAPL", "MSFT", "AMZN", "NFLX", "GOOG", "JPM", "XOM", "JNJ", "WMT", "PG",
                   "KO", "PFE", "INTC", "CSCO", "ORCL", "IBM", "BA", "DIS", "NKE", "MCD"]
        self.symbols = [self.add_equity(t, Resolution.DAILY).symbol for t in tickers]
        self.spy = self.add_equity("SPY", Resolution.DAILY).symbol
        self.set_benchmark(self.spy)
        self.horizon = 5          # hold ~1 week
        self.n_side = 3           # stocks per side
        self.long_short = True    # False = long-only (top picks only)
        self.lookback_days = 1500
        self.model = None
        self.train_model()
        self.train(self.date_rules.month_start(), self.time_rules.at(7, 0), self.train_model)
        self.schedule.on(self.date_rules.week_start(self.spy),
                         self.time_rules.after_market_open(self.spy, 30),
                         self.rebalance)

