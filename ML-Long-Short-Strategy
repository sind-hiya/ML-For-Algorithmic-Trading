    def features(self,symbol,days):
        px = self.history(symbol, days, Resolution.DAILY) # requests price data for apple for the last 'days' days
        if px.empty:
            return None
        px = px.loc[symbol]
        close = px["close"]
        #idx = px.index.normalize()
        #if self.sent_series is None:
            #sent_score = pd.Series(0.0, index=idx)
            #stale = pd.Series(30.0, index=idx)
        #else:
            #s = self.sent_series
            #full = s.index.union(idx)
            # last known score, aligned to trading days, lagged one day
            #sent_score = s.reindex(full).ffill().reindex(idx).shift(1).fillna(0)
            # days since the last headline, lagged one day, capped at 30
            #last = pd.Series(s.index, index=s.index).reindex(full).ffill().reindex(idx)
            #stale = (pd.Series(idx, index=idx) - last).dt.days.shift(1).fillna(30).clip(upper=30)
            
        delta = close.diff() #todays close minus yesterdays close
        gain = delta.clip(lower=0).rolling(14).mean() #average gain over last 2 weeks
        loss = (-delta.clip(upper=0)).rolling(14).mean() #average loss over last 2 weeks

        f = pd.DataFrame(index=px.index) #empty table. number of rows = number of trading days
        f["ret1"] = close.pct_change() #percentage change in closing price over last day
        f["ret5"] = close.pct_change(5) #percentage change in closing price over last 5 days
        f["ret20"] = close.pct_change(20) #percentage change in closing price over last 5 days
        f["ma10"] = close / close.rolling(10).mean() - 1 #compares yesterdays close to average over last 10 days
        f["ma50"] = close / close.rolling(50).mean() - 1 # compares yesterdays close to average over last 50 days
        f["rsi"] = 100 - 100 / (1 + gain / loss) #how much gains dominated losses
        f["vol20"] = f["ret1"].rolling(20).std() #standard deviation of daily returns over 20 days
        f["volratio"] = px["volume"] / px["volume"].rolling(20).mean() #compares volume to average volume over 20 days
        #f["sentiment"] = sent_score.values
        #f["stale"] = stale.values
        f["close"] = close 
        return f.replace([np.inf, -np.inf], np.nan) #clears infinities

    def train_model(self):
        frames =[]
        for sym in self.symbols:
            f = self.features(sym, self.lookback_days)
            if f is None:
                continue
            f["fwd"] = f["close"].shift(-self.horizon)/f["close"] -1
            frames.append(f)
        if not frames:
            return
        data = pd.concat(frames)
        data["y"] = data["fwd"] - data.groupby(level=0)["fwd"].transform("mean") #compares return to average return for that day
        data = data.drop(columns=["close", "fwd"]).dropna() 
        if len(data) < 1000:
            return
        X, y = data.drop(columns="y"), data["y"]
        self.model = make_pipeline(StandardScaler(), Ridge(alpha=100.0))
        self.model.fit(X, y)
        self.feature_cols = list(X.columns)

    def rebalance(self):
        if self.model is None:
            return
        preds = {}
        for sym in self.symbols:
            f = self.features(sym, 120)
            if f is None:
                continue
            x = f.drop(columns="close").iloc[[-1]] #yesterdays close
            if x.isna().any().any(): #skips blank rows
                continue
            preds[sym] = float(self.model.predict(x[self.feature_cols])[0]) #feeds row into model in correct order
        if len(preds) < 2 * self.n_side: #if too many stocks skipped does nothing
            return

        ranked = sorted(preds, key=lambda s: preds[s])#sorts stocks from highest to lowest
        longs = ranked[-self.n_side:] #highest 3 scores
        shorts = ranked[:self.n_side] #lowest three scores

        if self.long_short:
            w = 0.5 / self.n_side            # 50% long, 50% short, net exposure ~0
            targets = [PortfolioTarget(s, w) for s in longs] + [PortfolioTarget(s, -w) for s in shorts]
        else:
            w = 1.0 / self.n_side
            targets = [PortfolioTarget(s, w) for s in longs]

        self.set_holdings(targets, True)     # True = close anything not in the list
        self.debug(f"{self.time.date()} long={[s.value for s in longs]} short={[s.value for s in shorts]}")
